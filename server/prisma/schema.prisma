// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StockType {
  IN
  OUT
  ADJUSTMENT
}

enum UserRole {
  ADMIN
  STAFF
}

enum TransactionStatus {
  DRAFT
  POSTED
  CANCELLED
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  userId     Int      @map("user_id")
  sessionId  String   @map("session_id")
  expiresAt  DateTime @map("expires_at")
  rememberMe Boolean  @default(false) @map("remember_me")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("refresh_tokens")
}

model User {
  id Int @id @default(autoincrement())
  role UserRole @default(STAFF)
  name String
  email String @unique
  password String
  is_active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  stockTransactions StockTransaction[]

  @@map("users")
}

model Category {
  id Int @id @default(autoincrement())
  name String @unique
  description String?
  is_active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id Int @id @default(autoincrement())

  categoryId Int @map("category_id")

  name String
  sku String @unique
  // barcode String? @unique // EAN

  unit String

  minimum_stock Int @default(0)

  description String?
  image String?

  is_active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  inventories Inventory[]
  stockTransactionItems StockTransactionItem[]
  stockMovements StockMovement[]

  @@index([categoryId])
  @@map("products")
}

model Supplier {
  id Int @id @default(autoincrement())

  name String
  code String @unique

  contact_person String
  phone String?
  email String

  city String
  address String

  is_active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockTransactions StockTransaction[]

  @@index([city])
  @@map("suppliers")
}

model Warehouse {
  id Int @id @default(autoincrement())

  name String
  code String @unique

  city String
  address String
  description String?

  // capacity Decimal? @db.Decimal(12, 2)
  // capacityUnit String? @map("capacity_unit")

  is_active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inventories Inventory[]
  stockTransactions StockTransaction[]
  stockMovements StockMovement[]

  @@index([city])
  @@map("warehouses")
}

model Inventory {
  id Int @id @default(autoincrement())

  productId Int @map("product_id")
  warehouseId Int @map("warehouse_id")

  quantity Int @default(0)

  // bin_location String? @map("bin_location") // lokasi fisik barang di dalam warehouse.

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("inventories")
}

model StockTransaction {
  id Int @id @default(autoincrement())

  transaction_number String @unique

  type StockType

  warehouseId Int @map("warehouse_id")
  supplierId Int? @map("supplier_id")
  userId Int @map("user_id")
  
  transaction_date DateTime
  notes String?
  status TransactionStatus @default(DRAFT)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull) // SetNull digunakan agar jika supplier dihapus, transaksi tetap ada namun supplierId menjadi null
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  stockTransactionItem StockTransactionItem[]
  movements StockMovement[]

  @@index([warehouseId, transaction_date])
  @@index([supplierId])
  @@index([userId])
  @@index([type, transaction_date])
  @@map("stock_transactions")
}

model StockTransactionItem {
  id Int @id @default(autoincrement())

  transactionId Int @map("transaction_id")
  productId Int @map("product_id")

  quantity Int

  physical_quantity Int? @map("physical_quantity")
  unit_price Decimal? @db.Decimal(15, 2)

  transaction StockTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@unique([transactionId, productId])
  @@map("stock_transaction_items")
}

model StockMovement {
  id Int @id @default(autoincrement())

  productId Int @map("product_id")
  warehouseId Int @map("warehouse_id")
  stocktransactionId Int @map("stock_transaction_id")

  type StockType

  quantity Int
  quantity_before Int @map("quantity_before")
  quantity_after Int @map("quantity_after")

  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  stockTransaction StockTransaction @relation(fields: [stocktransactionId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([warehouseId])
  @@index([stocktransactionId])
  @@index([createdAt])
  @@map("stock_movements")
}

