@baseUrl = http://localhost:3000/api

### get all categories
GET {{baseUrl}}/categories
Content-Type: application/json

### get category by id
GET {{baseUrl}}/categories/4
Content-Type: application/json

### create category
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "Komponen Komputer",
  "description": "test",
  "is_active": true
}

### update category
PATCH {{baseUrl}}/categories/3
Content-Type: application/json

{
  "name": "Aksesoris Komputer",
  "description": "Mouse, keyboard, webcam, dan aksesoris",
  "is_active": true
}

# {
#   "name": "Perangkat Komputer"
# }

### delete category
DELETE {{baseUrl}}/categories/1
Content-Type: application/json