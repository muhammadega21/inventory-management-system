@baseUrl = http://localhost:3000/api

### get all categories
GET {{baseUrl}}/categories
Content-Type: application/json

### get category by id
GET {{baseUrl}}/categories/4
Content-Type: application/json

### create category
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "test 2",
  "description": "test 2",
  "is_active": true
}

### update category
PATCH {{baseUrl}}/categories/1
Content-Type: application/json

# {
#   "name": "test",
#   "description": "test",
#   "is_active": true
# }

{
  "name": "test update"
}

### delete category
DELETE {{baseUrl}}/categories/1
Content-Type: application/json