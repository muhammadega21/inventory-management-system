@baseUrl = http://localhost:3000/api

### get all products
GET {{baseUrl}}/products
Content-Type: application/json

### get product by id
GET {{baseUrl}}/products/1
Content-Type: application/json

### get active products
GET {{baseUrl}}/products?is_active=true
Content-Type: application/json

### get inactive products
GET {{baseUrl}}/products?is_active=false
Content-Type: application/json

### get products by category id
GET {{baseUrl}}/products?categoryId=1
Content-Type: application/json

### get products by search
GET {{baseUrl}}/products?search=product
Content-Type: application/json

### get products by sort
GET {{baseUrl}}/products?sortBy=name&sortOrder=desc
Content-Type: application/json

### get products, full filter
GET {{baseUrl}}/products?page=1&limit=10&is_active=true&sortBy=name&sortOrder=desc&categoryId=2&search=product
Content-Type: application/json

### create product
POST {{baseUrl}}/products
Content-Type: application/json

{
    "category_id": 2,
    "name": "Product 2",
    "unit": "pcs",
    "minimum_stock": 100,
    "description": "Product 2 description",
    "image": "https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=870&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
}

### update product
PATCH  {{baseUrl}}/products/2
Content-Type: application/json

{
    "category_id": 2,
    "name": "Product 2 updated",
    "unit": "pcs",
    "minimum_stock": 80,
    "description": "Product 2 description updated",
    "image": "https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=870&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
}

### delete product
DELETE {{baseUrl}}/products/2
Content-Type: application/json